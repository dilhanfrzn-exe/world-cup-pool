# Copy this file to `.env.local` and fill in your Supabase project values.
# Get these from: Supabase Dashboard -> Project Settings -> API

# Public project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Public anon key (safe to expose to the browser; used for future realtime/auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key


# Service role key (SERVER ONLY — never expose to the browser).
# Used by server actions/components to read & write data without auth in the MVP.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# Public base URL of the app, used to build shareable invite links.
# For local dev this is fine; on Vercel set it to your deployed domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated list of emails that get the all-rooms super-admin dashboard
# and host powers in every pool. Use the email(s) you sign up with.
SUPERADMIN_EMAILS=you@example.com


# --- API-Football (https://www.api-football.com/) -------------------------
# SERVER ONLY — never expose to the browser, so DO NOT prefix with NEXT_PUBLIC.
# Used to auto-sync World Cup fixtures, results and standings.
API_FOOTBALL_KEY=your-api-football-key

# Optional override of the API base host (defaults to the direct API-Sports host).
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Optional: World Cup league/season the sync targets (defaults below).
# API_FOOTBALL_LEAGUE_ID=1
# API_FOOTBALL_SEASON=2026

# Secret required by the scheduled-sync cron route (/api/cron/sync). Vercel Cron
# should send it as the `Authorization: Bearer <CRON_SECRET>` header. SERVER ONLY.
CRON_SECRET=generate-a-long-random-string
